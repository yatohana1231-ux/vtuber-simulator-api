{
  "name": "vtuber-simulator-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:bundle && npm run build:content",
    "build:bundle": "esbuild src/handlers/absenceSimulator.ts src/handlers/emotionUpdater.ts src/handlers/memoryRetriever.ts src/handlers/dialogueGenerator.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --out-extension:.js=.mjs --external:@aws-sdk/* --loader:.mustache=text",
    "build:content": "node scripts/copy-content.mjs",
    "build:watch": "npm run build:content && npm run build:bundle -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai": "node test/ai-response/run.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.826.0",
    "@aws-sdk/client-dynamodb": "^3.826.0",
    "@aws-sdk/lib-dynamodb": "^3.826.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  }
}
